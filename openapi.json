  "openapi": "3.1.0",
  "info": {
    "title": "AEOS Empire Autonomous Ecosystem API",
    "version": "1.0.0",
    "description": "Official public API for the AEOS Empire 14-platform sovereign constellation architected and founded by Mr. Kamel HOMRI. Powers automated deliverability diagnostics, platform telemetry, and B2B workflow orchestration.",
    "contact": {
      "name": "Kamel HOMRI",
